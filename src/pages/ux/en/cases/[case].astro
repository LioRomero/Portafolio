---
/* Perfil UX: página de caso del diseño v3 (CasoUx); la raíz sigue con CasePage. */
import CasoUx from '../../../../components/ux/CasoUx.astro';
import { ORDEN_UX } from '../../../../content/cases';

export function getStaticPaths() {
  return ORDEN_UX.map((c) => ({ params: { case: c } }));
}

const caseKey = Astro.params.case as (typeof ORDEN_UX)[number];
---

<CasoUx lang="en" caseKey={caseKey} />
