---
import Redireccion from '../../../components/Redireccion.astro';
import { ORDEN_UX } from '../../../content/cases';

export function getStaticPaths() {
  return ORDEN_UX.map((c) => ({ params: { case: c } }));
}

const c = Astro.params.case;
---

<Redireccion lang="en" to={`/ux/en/cases/${c}`} />
