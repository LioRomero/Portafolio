---
/**
 * /ux/ no tiene índice de casos: los tres están en la home, en la sección
 * #casos, que es adonde lleva "← Todos los casos". Esta página solo existe
 * para que un enlace viejo a /ux/casos no termine en un 404.
 */
import { rutas } from '../../content/profiles';
import type { Lang } from '../../content/ui';
import { withBase } from '../../lib/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const destino = `${withBase(rutas('ux', lang).home)}#casos`;
const texto = lang === 'es' ? 'Los casos están en la página de inicio.' : 'The cases are on the home page.';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${destino}`} />
    <link rel="canonical" href={new URL(destino, Astro.site).href} />
    <title>Emilio Romero</title>
  </head>
  <body>
    <p><a href={destino}>{texto}</a></p>
  </body>
</html>
