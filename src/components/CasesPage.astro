---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from './ContactSection.astro';
import Intro from '../islands/Intro.tsx';
import Tutorial from '../islands/Tutorial.tsx';
import Puzzle from '../islands/Puzzle.tsx';
import EmotionCanvas from '../islands/EmotionCanvas.tsx';
import CuriousLayer from '../islands/CuriousLayer.tsx';
import CaseNav from '../islands/CaseNav.tsx';
import { CASES, CASES_UI, CASE_ORDER } from '../content/cases';
import { INTRO } from '../content/intro';
import { ROUTES, type Lang } from '../content/ui';
import { withBase } from '../lib/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = CASES_UI[lang];
const r = ROUTES[lang];

const title = lang === 'es' ? 'Casos — Emilio Romero' : 'Cases — Emilio Romero';
const description = CASES.ropofy[lang].sub;

const tabs = CASE_ORDER.map((k) => ({ key: k, label: CASES[k].tab, accent: CASES[k].accent }));
---

<BaseLayout title={title} description={description} lang={lang} page="cases">
  <Intro variant="casos" lang={lang} client:load />
  <Tutorial lang={lang} delay={2600} client:idle />
  <CuriousLayer
    lang={lang}
    research={{ label: ui.researchMode, hint: ui.shortcutsHint }}
    client:idle
  />
  <CaseNav tabs={tabs} navLabel={ui.onThisPage} client:idle />

  {/* La página abre directamente con el primer caso, así que no hay un título
      visible que sirva de h1. Sin él la jerarquía empieza en h2 y el documento
      queda sin encabezado principal. */}
  <h1 class="sr-only">{INTRO.casos[lang].lineA}</h1>

  {
    CASE_ORDER.map((key, ci) => {
      const c = CASES[key];
      const d = c[lang];
      const nextKey = CASE_ORDER[(ci + 1) % CASE_ORDER.length]!;
      return (
        <article class="case" id={key} data-case={key} style={`--accent:${c.accent}`}>
          <section class="section">
            <div class="wrap wrap--cases">
              <div class="chips">
                {d.chips.map(([label, kind]) => (
                  <span class={`chip chip--${kind}`}>{label}</span>
                ))}
              </div>

              <h2 class="case-title">{d.title}</h2>
              <p class="case-sub">{d.sub}</p>

              <div class="cols">
                {d.cols.map((col) => (
                  <div class={col[2] ? 'col col--win' : 'col'}>
                    <div class="col-label">{col[0]}</div>
                    <p class="col-text">{col[1]}</p>
                  </div>
                ))}
              </div>

              {/* La nota de diseño explica por qué el caso está contado así.
                  Vive detrás del modo investigador (tecla R), no del modo de
                  lectura: es comentario sobre la pieza, no parte del caso. */}
              <aside class="design-note">
                <div class="note-label">{ui.designNote}</div>
                <p class="note-text">{d.note}</p>
              </aside>

              {/* 01 · El encargo */}
              <section class="block">
                <div class="kicker label">{ui.kickers[0]}</div>
                <h3>{d.brief.h2}</h3>
                <p class="body">{d.brief.p1}</p>
                <p class="body">{d.brief.p2}</p>
                <div class="ask-real">
                  <div class="ask">
                    <div class="col-label">{ui.theBrief}</div>
                    <p class="quote-line">{d.brief.asked}</p>
                  </div>
                  <div class="real">
                    <div class="col-label">{ui.realProblem}</div>
                    <p class="quote-line quote-line--real">{d.brief.real}</p>
                  </div>
                </div>
              </section>

              {/* 02 · Investigación */}
              <section class="block">
                <div class="kicker label">{ui.kickers[1]}</div>
                <h3>{d.research.h2}</h3>
                <p class="body">{d.research.p}</p>

                <ul class="stats">
                  {d.research.stats.map(([n, l]) => (
                    <li>
                      <span class="stat-n tabular">{n}</span>
                      <span class="stat-l">{l}</span>
                    </li>
                  ))}
                </ul>

                <div class="col-label questions-label">{ui.questionsAsked}</div>
                <ul class="questions">
                  {d.research.questions.map((q) => (
                    <li>{q}</li>
                  ))}
                </ul>

                <p class="meta caveat">{d.research.note}</p>
              </section>

              {/* 03 · Hallazgos */}
              <section class="block">
                <div class="kicker label">{ui.kickers[2]}</div>
                <h3>{d.findings.h2}</h3>
                <div class="findings">
                  {d.findings.items.map((f) => (
                    <div class={`finding finding--${f.color}`}>
                      <div class="finding-tag">{f.tag}</div>
                      <h4 class="finding-h">{f.h3}</h4>
                      <p class="body">{f.p}</p>
                      {'quote' in f && f.quote && (
                        <blockquote class={'plain' in f && f.plain ? 'fq fq--plain' : 'fq'}>
                          {f.quote}
                        </blockquote>
                      )}
                      {'caveat' in f && f.caveat && <p class="meta caveat">{f.caveat}</p>}
                    </div>
                  ))}
                </div>
              </section>

              {/* 04 · Decisiones */}
              <section class="block">
                <div class="kicker label">{ui.kickers[3]}</div>
                <h3>{d.decisions.h2}</h3>
                <ol class="decisions">
                  {d.decisions.items.map((it) => (
                    <li class={it[2] ? 'decision decision--ruled' : 'decision'}>
                      <h4 class="decision-h">{it[0]}</h4>
                      <p class="body">{it[1]}</p>
                    </li>
                  ))}
                </ol>
              </section>

              {/* 05 · La solución */}
              <section class="block">
                <div class="kicker label">{ui.kickers[4]}</div>
                <figure class="hero-fig">
                  <img src={withBase(d.hero.src)} alt={d.hero.ph} loading="lazy" decoding="async" />
                </figure>

                <div class="pairs">
                  {d.pairs.map((p) => (
                    <figure class="pair">
                      <img src={withBase(p.src)} alt={p.ph} loading="lazy" decoding="async" />
                      <figcaption class="meta">{p.cap}</figcaption>
                    </figure>
                  ))}
                </div>

                {'flow' in d && d.flow && (
                  <figure class="flow">
                    <img src={withBase(d.flow.src)} alt={d.flow.ph} loading="lazy" decoding="async" />
                    <figcaption class="meta">{d.flow.cap}</figcaption>
                  </figure>
                )}
              </section>

              {/* 06 · Resultado */}
              <section class="block">
                <div class="kicker label">{ui.kickers[5]}</div>
                <div class={`result result--${d.result.tone}`}>
                  <span class={'small' in d.result && d.result.small ? 'big big--small' : 'big'}>
                    {d.result.big}
                  </span>
                  <p class="result-p">{d.result.p}</p>
                </div>
                <p class="body result-secondary">{d.result.secondary}</p>
              </section>

              {/* 07 · Qué me dejó */}
              <section class="block">
                <div class="kicker label">{ui.kickers[6]}</div>
                <div class="takeaways">
                  {d.takeaways.map(([h, body, tone]) => (
                    <div class={`takeaway takeaway--${tone}`}>
                      <h4 class="decision-h">{h}</h4>
                      <p class="body">{body}</p>
                    </div>
                  ))}
                </div>
              </section>

              <p class="next">
                <a href={`#${nextKey}`}>
                  {ui.nextCase}: {CASES[nextKey].tab} →
                </a>
              </p>
            </div>
          </section>
        </article>
      );
    })
  }

  <section class="section bordered" data-playful>
    <div class="wrap wrap--canvas">
      <Puzzle variant="casos" lang={lang} client:visible />
    </div>
  </section>

  <section class="section bordered" data-playful>
    <div class="wrap wrap--canvas">
      <EmotionCanvas lang={lang} client:visible />
    </div>
  </section>

  <ContactSection lang={lang} title={ui.ctaTitle} sub={ui.ctaSub} />

  <p class="back-home section">
    <a href={withBase(r.home)}>{ui.backHome}</a>
  </p>
</BaseLayout>

<style>
  .bordered {
    border-top: var(--border);
  }

  .case + .case {
    border-top: var(--border);
  }

  .case-title {
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.035em;
    max-width: 900px;
    margin-bottom: 16px;
  }

  .case-sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--dim);
    max-width: var(--max-read);
    margin-bottom: 34px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }

  .chip {
    padding: 5px 12px;
    border-radius: var(--r-tag);
    font-size: 12px;
    font-weight: var(--fw-medium);
  }

  .chip--clarity {
    background: var(--clarity-deep);
    color: var(--on-clarity);
  }

  .chip--mind {
    background: var(--mind-deep);
    color: var(--on-mind);
  }

  .chip--feel {
    background: var(--feel-deep);
    color: var(--on-feel);
  }

  .chip--line {
    border: var(--border);
    color: var(--dim);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--gap-cards);
  }

  .col {
    border: var(--border);
    border-radius: var(--r-card);
    padding: 20px 22px;
    background: var(--surface);
  }

  .col--win {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .col-label {
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--dimmer);
    margin-bottom: 10px;
  }

  .col--win .col-label {
    color: var(--accent);
  }

  .col-text {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--dim);
  }

  /* Oculta salvo en modo investigador. Nada del caso vive aquí: es metacomentario. */
  .design-note {
    display: none;
    margin: 30px 0 0;
    border-left: 2px solid var(--feel);
    padding-left: 18px;
    max-width: var(--max-read);
  }

  :global(html[data-research]) .design-note {
    display: block;
  }

  .note-label {
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--feel);
    margin-bottom: 8px;
  }

  .note-text {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--dim);
  }

  .block {
    margin-top: 64px;
  }

  .kicker {
    color: var(--accent);
    margin-bottom: 14px;
  }

  .block h3 {
    max-width: 820px;
    margin-bottom: 16px;
  }

  .body {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--dim);
    max-width: var(--max-read);
  }

  .body + .body {
    margin-top: 12px;
  }

  .ask-real {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--gap-cards);
    margin-top: 26px;
  }

  .ask,
  .real {
    border: var(--border);
    border-radius: var(--r-card);
    padding: 20px 22px;
    background: var(--surface);
  }

  .real {
    border-color: var(--feel-deep);
  }

  .quote-line {
    font-size: 17px;
    line-height: 1.45;
    color: var(--dim);
  }

  .quote-line--real {
    color: var(--on-feel);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--gap-cards);
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .stats li {
    border-left: 1px solid var(--line);
    padding-left: 16px;
  }

  .stat-n {
    display: block;
    font-size: 24px;
    font-weight: var(--fw-medium);
    letter-spacing: -0.03em;
    color: var(--accent);
    margin-bottom: 6px;
  }

  .stat-l {
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    color: var(--dimmer);
  }

  .questions-label {
    margin: 30px 0 12px;
  }

  .questions {
    margin: 0;
    padding-left: 20px;
    max-width: var(--max-read);
  }

  .questions li {
    font-size: var(--fs-body);
    line-height: var(--lh-body-sm);
    color: var(--dim);
    margin-bottom: 8px;
  }

  .caveat {
    margin-top: 16px;
    max-width: var(--max-read);
  }

  .findings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--gap-cards);
    margin-top: 26px;
  }

  .finding {
    border: var(--border);
    border-top: 2px solid var(--mind);
    border-radius: var(--r-card);
    padding: 22px 24px;
    background: var(--surface);
  }

  .finding--feel {
    border-top-color: var(--feel);
  }

  .finding--clarity {
    border-top-color: var(--clarity);
  }

  .finding-tag {
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--mind);
    margin-bottom: 10px;
  }

  .finding--feel .finding-tag {
    color: var(--feel);
  }

  .finding--clarity .finding-tag {
    color: var(--clarity);
  }

  .finding-h {
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  .finding .body {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
  }

  .fq {
    margin: 14px 0 0;
    padding-left: 14px;
    border-left: 2px solid var(--line-strong);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--text);
  }

  .fq--plain {
    color: var(--dim);
    font-style: normal;
  }

  .decisions,
  .takeaways {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--gap-cards);
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .decision,
  .takeaway {
    border: var(--border);
    border-radius: var(--r-card);
    padding: 22px 24px;
    background: var(--surface);
  }

  /* La descartada se marca en coral: es una decisión, no un fracaso. */
  .decision--ruled {
    border-color: var(--feel-deep);
    background: color-mix(in srgb, var(--feel) 7%, transparent);
  }

  .takeaway--clarity {
    border-left: 2px solid var(--clarity);
  }

  .takeaway--feel {
    border-left: 2px solid var(--feel);
  }

  .decision-h {
    font-size: 17px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  .decision .body,
  .takeaway .body {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
  }

  .hero-fig,
  .flow,
  .pair {
    margin: 0;
    border: var(--border);
    border-radius: var(--r-card-lg);
    overflow: hidden;
    background: var(--bg-2);
  }

  .hero-fig img,
  .flow img,
  .pair img {
    width: 100%;
    height: auto;
  }

  .pairs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--gap-cards);
    margin-top: var(--gap-cards);
  }

  .flow {
    margin-top: var(--gap-cards);
  }

  .pair figcaption,
  .flow figcaption {
    padding: 12px 16px;
    border-top: var(--border);
  }

  .result {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 20px;
    border-left: 2px solid var(--clarity);
    padding-left: 22px;
    margin-top: 8px;
  }

  .result--mind {
    border-left-color: var(--mind);
  }

  .big {
    font-size: 62px;
    font-weight: var(--fw-light);
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--on-clarity);
  }

  .result--mind .big {
    color: var(--on-mind);
  }

  .big--small {
    font-size: 36px;
  }

  .result-p {
    flex: 1;
    min-width: 280px;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--dim);
    max-width: 560px;
  }

  .result-secondary {
    margin-top: 22px;
  }

  .next {
    margin-top: 56px;
    font-size: var(--fs-body-lg);
  }

  .back-home {
    padding-top: 0;
    font-size: var(--fs-body);
  }

  @media (max-width: 900px) {
    .case-title {
      font-size: 27px;
    }

    .case-sub {
      font-size: 16px;
    }

    .block {
      margin-top: 44px;
    }

    .big {
      font-size: 42px;
    }

    .big--small {
      font-size: 28px;
    }
  }
</style>
