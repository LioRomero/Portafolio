---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from './ContactSection.astro';
import Intro from '../islands/Intro.tsx';
import Tutorial from '../islands/Tutorial.tsx';
import CuriousLayer from '../islands/CuriousLayer.tsx';
import CaseNav from '../islands/CaseNav.tsx';
import CaseGallery, { type Lamina } from '../islands/CaseGallery.tsx';
import { PASOS } from '../content/pasos';
import CaseRail from '../islands/CaseRail.tsx';
import { CASES, CASES_UI, CASE_ORDER, type CaseKey } from '../content/cases';
import { ROUTES, type Lang } from '../content/ui';
import { withBase, diagrama } from '../lib/paths';

interface Props {
  lang: Lang;
  caseKey: CaseKey;
}

const { lang, caseKey } = Astro.props;
const ui = CASES_UI[lang];
const r = ROUTES[lang];

/* Cada caso vive en su propia URL: /casos/ropofy, etc. La página renderiza uno
   solo, y la navegación anterior/siguiente lleva a sus hermanos. Así el lector
   sabe siempre dónde empieza y termina un caso: lo marca la propia dirección. */
const key = caseKey;
const c = CASES[key];
const d = c[lang];

const ci = CASE_ORDER.indexOf(key);
const prevKey = CASE_ORDER[(ci - 1 + CASE_ORDER.length) % CASE_ORDER.length]!;
const nextKey = CASE_ORDER[(ci + 1) % CASE_ORDER.length]!;

const caseHref = (k: CaseKey) => withBase(`${r.cases}/${k}`);

const title = `${c.tab} — ${lang === 'es' ? 'Caso' : 'Case'} · Emilio Romero`;
const description = d.sub;

const tabs = CASE_ORDER.map((k) => ({
  key: k,
  label: CASES[k].tab,
  accent: CASES[k].accent,
  href: caseHref(k),
}));

/**
 * Todas las imágenes de un caso en un solo carrusel: la principal, el par
 * antes/después y el diagrama de flujo. El pie viaja con cada lámina.
 */
/* Se tipa por estructura y no con el tipo del caso: `as const` convierte cada
   texto en un tipo literal propio, así que los tres casos son incompatibles
   entre sí y ninguno serviría como parámetro común. */
interface FuenteLaminas {
  readonly hero: { readonly src: string; readonly ph: string };
  readonly pairs: readonly { readonly src: string; readonly ph: string; readonly cap: string }[];
  readonly flow?: { readonly src: string; readonly ph: string; readonly cap: string };
}

const laminasDe = (d: FuenteLaminas): Lamina[] => {
  const laminas: Lamina[] = [{ src: diagrama(d.hero.src, lang), alt: d.hero.ph, cap: d.hero.ph }];
  for (const p of d.pairs) laminas.push({ src: diagrama(p.src, lang), alt: p.ph, cap: p.cap });
  /* El `flow` ya no entra al carrusel: el recorrido se dibuja con DOM en el
     bloque de pasos, mas abajo. Una imagen menos que cargar por caso. */
  return laminas;
};
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  page="cases"
  altEs={`${ROUTES.es.cases}/${key}`}
  altEn={`${ROUTES.en.cases}/${key}`}
>
  <Intro variant="casos" lang={lang} client:load />
  <Tutorial lang={lang} delay={2600} client:idle />
  <CuriousLayer
    lang={lang}
    research={{ label: ui.researchMode, hint: ui.shortcutsHint }}
    client:idle
  />
  <CaseNav tabs={tabs} current={key} navLabel={ui.onThisPage} client:idle />
  <CaseRail etapas={[...ui.rail]} titulo={ui.onThisPage} client:idle />

  <article class="case" id={key} data-case={key} style={`--accent:${c.accent}`}>
          <section class="section">
            <div class="wrap wrap--cases">
              <div class="chips">
                {d.chips.map(([label, kind]) => (
                  <span class={`chip chip--${kind}`}>{label}</span>
                ))}
              </div>

              <h1 class="case-title">{d.title}</h1>
              <p class="case-sub">{d.sub}</p>

              <div class="cols">
                {d.cols.map((col) => (
                  <div class={col[2] ? 'col col--win' : 'col'}>
                    <div class="col-label">{col[0]}</div>
                    <p class="col-text">{col[1]}</p>
                  </div>
                ))}
              </div>

              {/* La nota de diseño explica por qué el caso está contado así.
                  Vive detrás del modo investigador (tecla R), no del modo de
                  lectura: es comentario sobre la pieza, no parte del caso. */}
              <aside class="design-note">
                <div class="note-label">{ui.designNote}</div>
                <p class="note-text">{d.note}</p>
              </aside>

              {/* 01 · El encargo */}
              <section class="block" data-caso={key} data-etapa="0">
                <div class="kicker label">{ui.kickers[0]}</div>
                <h2>{d.brief.h2}</h2>
                <p class="body">{d.brief.p1}</p>
                <p class="body">{d.brief.p2}</p>
                <div class="ask-real">
                  <div class="ask">
                    <div class="col-label">{ui.theBrief}</div>
                    <p class="quote-line">{d.brief.asked}</p>
                  </div>
                  <div class="real">
                    <div class="col-label">{ui.realProblem}</div>
                    <p class="quote-line quote-line--real">{d.brief.real}</p>
                  </div>
                </div>
              </section>

              {/* 02 · Investigación */}
              <section class="block" data-caso={key} data-etapa="1">
                <div class="kicker label">{ui.kickers[1]}</div>
                <h2>{d.research.h2}</h2>
                <p class="body">{d.research.p}</p>

                <div class="col-label method-label">{ui.methodLabel}</div>
                <ul class="stats">
                  {d.research.stats.map(([n, l]) => (
                    <li>
                      <span class="stat-n tabular">{n}</span>
                      <span class="stat-l">{l}</span>
                    </li>
                  ))}
                </ul>

                <div class="col-label questions-label">{ui.questionsAsked}</div>
                <ul class="questions">
                  {d.research.questions.map((q) => (
                    <li>{q}</li>
                  ))}
                </ul>

                <p class="meta caveat">{d.research.note}</p>
              </section>

              {/* 03 · Hallazgos */}
              <section class="block" data-caso={key} data-etapa="2">
                <div class="kicker label">{ui.kickers[2]}</div>
                <h2>{d.findings.h2}</h2>
                <div class="findings">
                  {d.findings.items.map((f) => (
                    <div class={`finding finding--${f.color}`}>
                      <div class="finding-tag">{f.tag}</div>
                      <h3 class="finding-h">{f.h3}</h3>
                      <p class="body">{f.p}</p>
                      {'quote' in f && f.quote && (
                        <blockquote class={'plain' in f && f.plain ? 'fq fq--plain' : 'fq'}>
                          {f.quote}
                        </blockquote>
                      )}
                      {'caveat' in f && f.caveat && <p class="meta caveat">{f.caveat}</p>}
                    </div>
                  ))}
                </div>
              </section>

              {/* 04 · Decisiones */}
              <section class="block" data-caso={key} data-etapa="3">
                <div class="kicker label">{ui.kickers[3]}</div>
                <h2>{d.decisions.h2}</h2>
                <ol class="decisions">
                  {d.decisions.items.map((it) => (
                    <li class={it[2] ? 'decision decision--ruled' : 'decision'}>
                      <h3 class="decision-h">{it[0]}</h3>
                      <p class="body">{it[1]}</p>
                    </li>
                  ))}
                </ol>
              </section>

              {/* 05 · La solución */}
              <section class="block" data-caso={key} data-etapa="4">
                <div class="kicker label">{ui.kickers[4]}</div>
                <CaseGallery
                  laminas={laminasDe(d)}
                  anterior={ui.prev}
                  siguiente={ui.next}
                  imagen={ui.slide}
                  accent={c.accent}
                  client:visible
                />

                {/* El recorrido, en DOM y no en imagen: se lee entero sin pasar
                    laminas, se traduce, lo alcanza un lector de pantalla y no
                    hay nada que pueda quedarse en blanco. */}
                {PASOS[key] && (
                  <div class="ruta">
                    <h3 class="ruta-h">{PASOS[key]![lang].titulo}</h3>
                    {PASOS[key]![lang].filas.map((fila) => (
                      <div class="ruta-fila">
                        {fila.etiqueta && (
                          <div class={`col-label ruta-et ruta-et--${fila.tono}`}>{fila.etiqueta}</div>
                        )}
                        <ol class="ruta-pasos">
                          {fila.pasos.map((paso, n) => (
                            <li class={`ruta-paso ruta-paso--${fila.tono}`}>
                              <span class="ruta-n tabular">{String(n + 1).padStart(2, '0')}</span>
                              <span class="ruta-t">{paso.t}</span>
                              <span class="ruta-d">{paso.d}</span>
                            </li>
                          ))}
                        </ol>
                      </div>
                    ))}
                    <p class="ruta-nota meta">{PASOS[key]![lang].nota}</p>
                  </div>
                )}
              </section>

              {/* 06 · Resultado */}
              <section class="block" data-caso={key} data-etapa="5">
                <div class="kicker label">{ui.kickers[5]}</div>
                <div class={`result result--${d.result.tone}`}>
                  <span class={'small' in d.result && d.result.small ? 'big big--small' : 'big'}>
                    {d.result.big}
                  </span>
                  <p class="result-p">{d.result.p}</p>
                </div>
                <p class="body result-secondary">{d.result.secondary}</p>
              </section>

              {/* 07 · Qué me dejó */}
              <section class="block" data-caso={key} data-etapa="6">
                <div class="kicker label">{ui.kickers[6]}</div>
                <div class="takeaways">
                  {d.takeaways.map(([h, body, tone]) => (
                    <div class={`takeaway takeaway--${tone}`}>
                      <h3 class="decision-h">{h}</h3>
                      <p class="body">{body}</p>
                    </div>
                  ))}
                </div>
              </section>

              <nav class="casefin" aria-label={ui.onThisPage}>
                <a class="casefin-link" href={caseHref(prevKey)}>
                  <span class="casefin-dir">← {ui.prevCase}</span>
                  <span class="casefin-tab">{CASES[prevKey].tab}</span>
                </a>
                <a class="casefin-link casefin-link--next" href={caseHref(nextKey)}>
                  <span class="casefin-dir">{ui.nextCase} →</span>
                  <span class="casefin-tab">{CASES[nextKey].tab}</span>
                </a>
              </nav>
            </div>
          </section>
        </article>

  <ContactSection lang={lang} title={ui.ctaTitle} sub={ui.ctaSub} />

  <p class="back-home section">
    <a href={withBase(r.cases)}>{ui.back}</a>
  </p>
</BaseLayout>

<style>
  .bordered {
    border-top: var(--border);
  }

  .case + .case {
    border-top: var(--border);
  }

  /* Al saltar desde el índice o desde las pestañas, el destino quedaría bajo
     la barra superior y la de casos, que son fijas. */
  .case,
  .block {
    scroll-margin-top: 116px;
  }

  .case-title {
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.035em;
    max-width: 900px;
    margin-bottom: 16px;
  }

  .case-sub {
    font-size: 18px;
    line-height: 1.6;
    color: var(--dim);
    max-width: var(--max-read);
    margin-bottom: 34px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }

  .chip {
    padding: 5px 12px;
    border-radius: var(--r-tag);
    font-size: 12px;
    font-weight: var(--fw-medium);
  }

  .chip--clarity {
    background: var(--clarity-deep);
    color: var(--on-clarity);
  }

  .chip--mind {
    background: var(--mind-deep);
    color: var(--on-mind);
  }

  .chip--feel {
    background: var(--feel-deep);
    color: var(--on-feel);
  }

  .chip--line {
    border: var(--border);
    color: var(--dim);
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--gap-cards);
  }

  .col {
    border: var(--border);
    border-radius: var(--r-card);
    padding: 20px 22px;
    background: var(--surface);
  }

  .col--win {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .col-label {
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--dimmer);
    margin-bottom: 10px;
  }

  .col--win .col-label {
    color: var(--accent);
  }

  .col-text {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--dim);
  }

  /* Oculta salvo en modo investigador. Nada del caso vive aquí: es metacomentario. */
  .design-note {
    display: none;
    margin: 30px 0 0;
    border-left: 2px solid var(--feel);
    padding-left: 18px;
    max-width: var(--max-read);
  }

  :global(html[data-research]) .design-note {
    display: block;
  }

  .note-label {
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--feel);
    margin-bottom: 8px;
  }

  .note-text {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--dim);
  }

  .block {
    margin-top: 64px;
  }

  .kicker {
    color: var(--accent);
    margin-bottom: 14px;
  }

  .block h2 {
    max-width: 820px;
    margin-bottom: 16px;
  }

  .body {
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--dim);
    max-width: var(--max-read);
  }

  .body + .body {
    margin-top: 12px;
  }

  .ask-real {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--gap-cards);
    margin-top: 26px;
  }

  .ask,
  .real {
    border: var(--border);
    border-radius: var(--r-card);
    padding: 20px 22px;
    background: var(--surface);
  }

  .real {
    border-color: var(--feel-deep);
  }

  .quote-line {
    font-size: 17px;
    line-height: 1.45;
    color: var(--dim);
  }

  .quote-line--real {
    color: var(--on-feel);
  }

  /* El recorrido de cada caso. Cada paso es una tarjeta con su numero, y la
     flecha entre pasos se dibuja con un pseudoelemento: sin imagenes, sin
     iconos y sin nada que pueda no cargar. En movil la fila se apila y la
     flecha pasa a apuntar hacia abajo. */
  .ruta {
    margin-top: 34px;
    padding-top: 26px;
    border-top: var(--border);
  }
  .ruta-h {
    font-size: var(--fs-h4, 19px);
    font-weight: var(--fw-medium);
    margin: 0 0 18px;
  }
  .ruta-fila + .ruta-fila { margin-top: 22px; }
  .ruta-et { margin-bottom: 10px; }
  .ruta-et--feel { color: var(--feel); }
  .ruta-et--clarity { color: var(--clarity); }
  .ruta-et--mind { color: var(--mind); }

  .ruta-pasos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ruta-paso {
    position: relative;
    display: grid;
    gap: 5px;
    align-content: start;
    padding: 14px 16px;
    border: var(--border);
    border-top: 2px solid var(--line-strong);
    border-radius: var(--r-card);
    background: var(--surface);
  }
  .ruta-paso--feel { border-top-color: var(--feel); }
  .ruta-paso--clarity { border-top-color: var(--clarity); }
  .ruta-paso--mind { border-top-color: var(--mind); }

  .ruta-paso:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: -11px;
    width: 8px;
    height: 8px;
    border-top: 1.5px solid var(--line-strong);
    border-right: 1.5px solid var(--line-strong);
    transform: translateY(-50%) rotate(45deg);
  }

  .ruta-n {
    font-size: 11px;
    letter-spacing: var(--ls-label);
    color: var(--dimmer);
  }
  .ruta-t { font-size: 15px; color: var(--text); }
  .ruta-d { font-size: var(--fs-meta); line-height: var(--lh-meta); color: var(--dim); }
  .ruta-nota { margin: 18px 0 0; }

  @media (max-width: 640px) {
    /* Apilados, la flecha lateral apuntaria al vacio: baja y gira. */
    .ruta-paso:not(:last-child)::after {
      top: auto;
      bottom: -11px;
      right: 50%;
      transform: translateX(50%) rotate(135deg);
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--gap-cards);
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  /* El metodo es la mitad del argumento en un caso de service design, asi que
     los datos se leen como evidencia y no como prosa: tarjeta propia y cifra
     grande, del mismo peso que la franja de metricas de la portada. */
  .stats li {
    border: var(--border);
    border-top: 2px solid var(--accent);
    border-radius: var(--r-card);
    background: var(--surface);
    padding: 20px 22px 22px;
  }

  .method-label {
    margin: 30px 0 0;
  }

  .stat-n {
    display: block;
    font-size: 40px;
    font-weight: var(--fw-medium);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--accent);
    margin-bottom: 10px;
  }

  .stat-l {
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    color: var(--dimmer);
  }

  .questions-label {
    margin: 30px 0 12px;
  }

  .questions {
    margin: 0;
    padding-left: 20px;
    max-width: var(--max-read);
  }

  .questions li {
    font-size: var(--fs-body);
    line-height: var(--lh-body-sm);
    color: var(--dim);
    margin-bottom: 8px;
  }

  .caveat {
    margin-top: 16px;
    max-width: var(--max-read);
  }

  .findings {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--gap-cards);
    margin-top: 26px;
  }

  .finding {
    border: var(--border);
    border-top: 2px solid var(--mind);
    border-radius: var(--r-card);
    padding: 22px 24px;
    background: var(--surface);
  }

  .finding--feel {
    border-top-color: var(--feel);
  }

  .finding--clarity {
    border-top-color: var(--clarity);
  }

  .finding-tag {
    font-size: var(--fs-label);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--mind);
    margin-bottom: 10px;
  }

  .finding--feel .finding-tag {
    color: var(--feel);
  }

  .finding--clarity .finding-tag {
    color: var(--clarity);
  }

  .finding-h {
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  .finding .body {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
  }

  .fq {
    margin: 14px 0 0;
    padding-left: 14px;
    border-left: 2px solid var(--line-strong);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
    color: var(--text);
  }

  .fq--plain {
    color: var(--dim);
    font-style: normal;
  }

  .decisions,
  .takeaways {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--gap-cards);
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .decision,
  .takeaway {
    border: var(--border);
    border-radius: var(--r-card);
    padding: 22px 24px;
    background: var(--surface);
  }

  /* La descartada se marca en coral: es una decisión, no un fracaso. */
  .decision--ruled {
    border-color: var(--feel-deep);
    background: color-mix(in srgb, var(--feel) 7%, transparent);
  }

  .takeaway--clarity {
    border-left: 2px solid var(--clarity);
  }

  .takeaway--feel {
    border-left: 2px solid var(--feel);
  }

  .decision-h {
    font-size: 17px;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  .decision .body,
  .takeaway .body {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body-sm);
  }

  /* Las figuras apiladas (hero, par antes/después y flujo) las sustituyó el
     carrusel `CaseGallery`, que trae sus propios estilos. */

  .result {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 20px;
    border-left: 2px solid var(--clarity);
    padding-left: 22px;
    margin-top: 8px;
  }

  .result--mind {
    border-left-color: var(--mind);
  }

  .big {
    font-size: 62px;
    font-weight: var(--fw-light);
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--on-clarity);
  }

  .result--mind .big {
    color: var(--on-mind);
  }

  .big--small {
    font-size: 36px;
  }

  .result-p {
    flex: 1;
    min-width: 280px;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--dim);
    max-width: 560px;
  }

  .result-secondary {
    margin-top: 22px;
  }

  /* Navegación de cierre: anterior y siguiente caso, cada uno con su dirección
     y el nombre del caso. Cierra la lectura y evita que el usuario tenga que
     subir a la barra para pasar al siguiente. */
  .casefin {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 56px;
    padding-top: 26px;
    border-top: var(--border);
  }
  .casefin-link {
    display: grid;
    gap: 4px;
