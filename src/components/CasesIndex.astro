---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from './ContactSection.astro';
import Intro from '../islands/Intro.tsx';
import Tutorial from '../islands/Tutorial.tsx';
import Puzzle from '../islands/Puzzle.tsx';
import EmotionCanvas from '../islands/EmotionCanvas.tsx';
import CuriousLayer from '../islands/CuriousLayer.tsx';
import Blueprint3D from '../islands/Blueprint3D.tsx';
import { CASES, CASES_UI, CASE_ORDER, type CaseKey } from '../content/cases';
import { ROUTES, type Lang } from '../content/ui';
import { withBase } from '../lib/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = CASES_UI[lang];
const r = ROUTES[lang];

const title = lang === 'es' ? 'Casos — Emilio Romero' : 'Cases — Emilio Romero';
const description = ui.indexLede;

const caseHref = (k: CaseKey) => withBase(`${r.cases}/${k}`);
---

<BaseLayout title={title} description={description} lang={lang} page="cases">
  <Intro variant="casos" lang={lang} client:load />
  <Tutorial lang={lang} delay={2600} client:idle />
  <CuriousLayer
    lang={lang}
    research={{ label: ui.researchMode, hint: ui.shortcutsHint }}
    client:idle
  />

  {/* El índice: la página ya no es un scroll infinito de tres casos pegados.
      Cada tarjeta lleva a su propia página, así el lector elige por dónde
      entrar y sabe siempre en cuál está. */}
  <section class="section">
    <div class="wrap wrap--cases">
      <h1 class="idx-h">{ui.indexTitle}</h1>
      <p class="idx-lede lead">{ui.indexLede}</p>

      <div class="idx-grid">
        {
          CASE_ORDER.map((key) => {
            const c = CASES[key];
            const d = c[lang];
            return (
              <a class="idx-card" href={caseHref(key)} style={`--accent:${c.accent}`}>
                <span class="idx-glare" aria-hidden="true"></span>
                <div class="idx-card-body">
                  <div class="chips">
                    {d.chips.map(([label, kind]) => (
                      <span class={`chip chip--${kind}`}>{label}</span>
                    ))}
                  </div>
                  <h2 class="idx-title">{d.title}</h2>
                  <p class="idx-sub">{d.sub}</p>
                  <div class="idx-foot">
                    <span class="idx-result">{d.result.big}</span>
                    <span class="idx-more">{ui.readCase} →</span>
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  {/* La herramienta del service design: se arma en el espacio y luego se
      explora. Va en el índice porque es el método detrás de los tres casos. */}
  <section class="section bordered" data-playful>
    <div class="wrap wrap--canvas">
      <Blueprint3D lang={lang} client:visible />
    </div>
  </section>

  <section class="section bordered" data-playful>
    <div class="wrap wrap--canvas">
      <Puzzle variant="casos" lang={lang} client:visible />
    </div>
  </section>

  <section class="section bordered" data-playful>
    <div class="wrap wrap--canvas">
      <EmotionCanvas lang={lang} client:visible />
    </div>
  </section>

  <ContactSection lang={lang} title={ui.ctaTitle} sub={ui.ctaSub} />

  <p class="back-home section">
    <a href={withBase(r.home)}>{ui.backHome}</a>
  </p>
</BaseLayout>

<script>
  /* Inclinación 3D de las tarjetas siguiendo el cursor. 3D de CSS puro, sin
     librería: la portada de casos se siente como objetos físicos, a juego con
     el archivador 3D de abajo. Se apaga en táctil (no hay hover) y con
     movimiento reducido. */
  const tarjetas = document.querySelectorAll<HTMLElement>('.idx-card');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const coarse = matchMedia('(pointer: coarse)');
  const activo = () =>
    !reduce.matches && !coarse.matches && document.documentElement.dataset.motion !== 'off';

  tarjetas.forEach((card) => {
    const glare = card.querySelector<HTMLElement>('.idx-glare');
    card.addEventListener('pointerenter', () => {
      if (activo()) card.style.transition = 'transform 80ms linear';
    });
    card.addEventListener('pointermove', (e) => {
      if (!activo()) return;
      const r = card.getBoundingClientRect();
      const fx = (e.clientX - r.left) / r.width; // 0..1
      const fy = (e.clientY - r.top) / r.height;
      // Inclinación marcada: hasta ±11°, con un realce y una elevación claros.
      card.style.transform =
        'perspective(800px) rotateX(' +
        ((0.5 - fy) * 16).toFixed(2) +
        'deg) rotateY(' +
        ((fx - 0.5) * 20).toFixed(2) +
        'deg) translateY(-6px) scale(1.02)';
      if (glare) {
        glare.style.setProperty('--mx', (fx * 100).toFixed(1) + '%');
        glare.style.setProperty('--my', (fy * 100).toFixed(1) + '%');
      }
    });
    card.addEventListener('pointerleave', () => {
      card.style.transition = '';
      card.style.transform = '';
    });
  });
</script>

<style>
  .bordered {
    border-top: var(--border);
  }
  .idx-h {
    font-size: var(--fs-h1, 2rem);
    font-weight: var(--fw-medium);
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .idx-lede {
    color: var(--dim);
    max-width: 60ch;
    margin: 0 0 34px;
  }

  /* Los chips se estilan por componente (no son globales), así que la portada
     de casos trae los suyos, iguales a los de cada caso. */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
  }
  .chip {
    padding: 5px 12px;
    border-radius: var(--r-tag);
    font-size: 12px;
    font-weight: var(--fw-medium);
  }
  .chip--clarity { background: var(--clarity-deep); color: var(--on-clarity); }
  .chip--mind { background: var(--mind-deep); color: var(--on-mind); }
  .chip--feel { background: var(--feel-deep); color: var(--on-feel); }
  .chip--line { border: var(--border); color: var(--dim); }

  .idx-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--gap-cards);
  }

  /* Cada tarjeta es la puerta a un caso, y se comporta como un objeto físico:
     se inclina en 3D siguiendo el cursor (lo hace el script del final) y un
     reflejo la recorre. La franja de color arriba es el acento del caso, para
     que Ropofy, QStrauss y BID se distingan de un vistazo. */
  .idx-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 24px;
    border: var(--border);
    border-top: 3px solid var(--accent);
    border-radius: var(--r-card-lg);
    background: var(--surface);
    text-decoration: none;
    overflow: hidden;
    transform-style: preserve-3d;
    transition:
      border-color var(--dur-hover) var(--ease-hover),
      transform var(--dur-hover) var(--ease-hover),
      box-shadow var(--dur-hover) var(--ease-hover);
  }
  /* Reposo sin cursor encima y respaldo para táctil / movimiento reducido:
     un realce claro que ya se ve sin depender del script. */
  .idx-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 26px 60px -28px rgba(0, 0, 0, 0.95), 0 0 40px -14px var(--accent);
  }
  .idx-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* El reflejo que sigue al cursor. Vive detrás del contenido para no lavar el
     texto; el script mueve --mx/--my. */
  .idx-glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      420px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--accent) 26%, transparent),
      transparent 60%
    );
    transition: opacity 0.25s var(--ease-hover);
  }
  .idx-card:hover .idx-glare {
    opacity: 1;
  }

  /* El contenido se adelanta en Z: con la tarjeta inclinada, el texto flota
     sobre el fondo y el 3D se siente de verdad. Sin script (táctil) queda plano
     y no pasa nada. */
  .idx-card-body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    transform: translateZ(34px);
    transform-style: preserve-3d;
  }
  html[data-motion='off'] .idx-card-body {
    transform: none;
  }

  .idx-title {
    font-size: var(--fs-h4, 20px);
    font-weight: var(--fw-medium);
    line-height: 1.25;
    color: var(--text);
    margin: 0;
  }
  .idx-sub {
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
    color: var(--dim);
    margin: 0;
    flex: 1;
  }
  .idx-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: 6px;
    padding-top: 14px;
    border-top: var(--border);
  }
  .idx-result {
    font-size: var(--fs-meta);
    color: var(--accent);
    font-weight: var(--fw-medium);
  }
  .idx-more {
    font-size: var(--fs-meta);
    color: var(--dim);
  }
  .idx-card:hover .idx-more {
    color: var(--text);
  }

  .back-home {
    padding-top: 0;
    font-size: var(--fs-body);
  }
</style>
