---
import '@fontsource/inter/latin-300.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
/* Solo la usa el tema claro de /ux/; una @font-face sin uso no se descarga. */
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import { DEFAULTS, KEYS } from '../lib/prefs';
import { UI, type Lang, type PageKey } from '../content/ui';
import { PROFILES, rutas, type Profile } from '../content/profiles';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  page: PageKey;
  /* Equivalente en el otro idioma, sin el prefijo de despliegue. Las páginas de
     caso lo pasan (/casos/ropofy ↔ /en/cases/ropofy) porque su ruta no está en
     ROUTES, que solo conoce los índices. El resto usa el índice de su sección. */
  altEs?: string;
  altEn?: string;
  /** Perfil de la página: `ba` en la raíz, `ux` bajo /ux/. */
  profile?: Profile;
  /**
   * `claro` es el diseño v3 de /ux/: paleta de papel y cabecera propia, que la
   * página pone en el slot `cabecera` (y su pie en `pie`). La raíz no lo usa.
   */
  tema?: 'oscuro' | 'claro';
  /** Pide aparecer en buscadores aunque el perfil sea noindex (casos de /ux/). */
  indexable?: boolean;
}

const { title, description, lang, page, altEs, altEn, profile = 'ba', tema = 'oscuro', indexable = false } = Astro.props;
const claro = tema === 'claro';

/* `Astro.url.pathname` ya incluye el `base`. Se fuerza la barra final para que
   la canónica coincida con lo que sirve GitHub Pages y con el sitemap: si no,
   la home queda como `/portafolio` y el sitemap dice `/portafolio/`. */
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site);
/* El sitio es bilingüe: cada página declara su equivalente en el otro idioma,
   siempre dentro de su perfil. */
const rutaEs = altEs ?? rutas(profile, 'es')[page];
const rutaEn = altEn ?? rutas(profile, 'en')[page];
const alternates = [
  { hreflang: 'es', href: new URL(withBase(rutaEs), Astro.site).href },
  { hreflang: 'en', href: new URL(withBase(rutaEn), Astro.site).href },
  { hreflang: 'x-default', href: new URL(withBase(rutaEs), Astro.site).href },
];
const ogImage = new URL(withBase(PROFILES[profile].ogImage), Astro.site).href;
/* Persona en datos estructurados (JSON-LD), solo en la home y en Sobre mí. Es
   donde vive el cargo completo para buscadores sin aparecer en la página: en
   la raíz, "UX Strategist & Business Analyst". */
const persona =
  page === 'home' || page === 'about'
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Emilio Romero',
        jobTitle: PROFILES[profile].puesto,
        url: new URL(withBase(rutas(profile, lang).home), Astro.site).href,
        address: { '@type': 'PostalAddress', addressLocality: 'Bogotá', addressCountry: 'CO' },
        sameAs: ['https://www.linkedin.com/in/emilio-romero-gutierrez'],
      })
    : null;
const noindex = PROFILES[profile].noindex && !indexable;
const favicon = withBase('/favicon.svg');
---

<!doctype html>
<html lang={lang} data-mode={DEFAULTS.mode} data-theme={claro ? 'claro' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={favicon} type="image/svg+xml" />

    <link rel="canonical" href={canonical} />
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:site_name" content="Emilio Romero" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {persona && <script is:inline type="application/ld+json" set:html={persona} />}

    {/*
      Modo, idioma y movimiento se aplican antes del primer pintado. Sin esto,
      quien guardó "explorar" vería un parpadeo del modo por defecto al cargar.
    */}
    <script is:inline define:vars={{ KEYS, DEFAULTS }}>
      try {
        var root = document.documentElement;
        var mode = localStorage.getItem(KEYS.mode);
        root.dataset.mode = mode === 'grano' || mode === 'explorar' ? mode : DEFAULTS.mode;
        if (localStorage.getItem('em-motion') === 'off') root.dataset.motion = 'off';
      } catch (e) {
        /* almacenamiento bloqueado: se queda con los valores por defecto */
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{UI[lang].skipToContent}</a>

    {
      claro ? (
        <slot name="cabecera" />
      ) : (
        <>
          <div id="read-progress" aria-hidden="true" />
          <TopBar lang={lang} page={page} profile={profile} otherHref={lang === 'es' ? rutaEn : rutaEs} />
        </>
      )
    }

    <main id="main">
      <slot />
    </main>

    <slot name="pie" />

    {/* Barra de progreso de lectura: 2px arriba, ancho proporcional al scroll. */}
    <script>
      const bar = document.getElementById('read-progress');
      if (bar) {
        let ticking = false;
        const update = () => {
          const d = document.documentElement;
          const max = Math.max(1, d.scrollHeight - d.clientHeight);
          bar.style.width = ((d.scrollTop / max) * 100).toFixed(2) + '%';
          ticking = false;
        };
        addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true }
        );
        update();
      }
    </script>


    <style>
      #read-progress {
        position: fixed;
        left: 0;
        top: 0;
        height: 2px;
        width: 0;
        z-index: 95;
        pointer-events: none;
        background: linear-gradient(90deg, var(--mind), var(--clarity));
      }
    </style>
  </body>
</html>
