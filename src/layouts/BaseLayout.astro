---
import '@fontsource/inter/latin-300.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import { DEFAULTS, KEYS } from '../lib/prefs';
import { UI, type Lang, type PageKey } from '../content/ui';
import { PROFILES, rutas, type Profile } from '../content/profiles';
import { withBase } from '../lib/paths';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  page: PageKey;
  /* Equivalente en el otro idioma, sin el prefijo de despliegue. Las páginas de
     caso lo pasan (/casos/ropofy ↔ /en/cases/ropofy) porque su ruta no está en
     ROUTES, que solo conoce los índices. El resto usa el índice de su sección. */
  altEs?: string;
  altEn?: string;
  /** Perfil de la página: `ba` en la raíz, `ux` bajo /ux/. */
  profile?: Profile;
}

const { title, description, lang, page, altEs, altEn, profile = 'ba' } = Astro.props;

/* `Astro.url.pathname` ya incluye el `base`. Se fuerza la barra final para que
   la canónica coincida con lo que sirve GitHub Pages y con el sitemap: si no,
   la home queda como `/portafolio` y el sitemap dice `/portafolio/`. */
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, Astro.site);
/* El sitio es bilingüe: cada página declara su equivalente en el otro idioma,
   siempre dentro de su perfil. */
const rutaEs = altEs ?? rutas(profile, 'es')[page];
const rutaEn = altEn ?? rutas(profile, 'en')[page];
const alternates = [
  { hreflang: 'es', href: new URL(withBase(rutaEs), Astro.site).href },
  { hreflang: 'en', href: new URL(withBase(rutaEn), Astro.site).href },
  { hreflang: 'x-default', href: new URL(withBase(rutaEs), Astro.site).href },
];
const ogImage = new URL(withBase(PROFILES[profile].ogImage), Astro.site).href;
const noindex = PROFILES[profile].noindex;
const favicon = withBase('/favicon.svg');
---

<!doctype html>
<html lang={lang} data-mode={DEFAULTS.mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={favicon} type="image/svg+xml" />

    <link rel="canonical" href={canonical} />
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:site_name" content="Emilio Romero" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/*
      Modo, idioma y movimiento se aplican antes del primer pintado. Sin esto,
      quien guardó "explorar" vería un parpadeo del modo por defecto al cargar.
    */}
    <script is:inline define:vars={{ KEYS, DEFAULTS, PERFIL: profile }}>
      var root = document.documentElement;
      try {
        var mode = localStorage.getItem(KEYS.mode);
        root.dataset.mode = mode === 'grano' || mode === 'explorar' ? mode : DEFAULTS.mode;
        if (localStorage.getItem('em-motion') === 'off') root.dataset.motion = 'off';
      } catch (e) {
        /* almacenamiento bloqueado: se queda con los valores por defecto */
      }
      /* Atajo Shift + Alt + P: el perfil elegido sigue al navegar en esta
         pestaña, y al recargar vuelve el de la URL. Si esta página tiene que
         mostrar el otro, sus textos de perfil se ocultan hasta que llegan, para
         que no se vea un parpadeo del perfil de la URL. */
      try {
        var nav = performance.getEntriesByType('navigation')[0];
        if (nav && nav.type === 'reload') sessionStorage.removeItem('em-perfil');
        var visto = sessionStorage.getItem('em-perfil');
        if (visto && visto !== PERFIL) {
          root.setAttribute('data-pv-pendiente', '');
          /* Red de seguridad: si el otro perfil no llega, vuelve el de la URL. */
          setTimeout(function () {
            root.removeAttribute('data-pv-pendiente');
          }, 2500);
        }
      } catch (e) {
        /* sin almacenamiento de sesión: cada página muestra el perfil de su URL */
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{UI[lang].skipToContent}</a>

    <div id="read-progress" aria-hidden="true"></div>

    <TopBar
      lang={lang}
      page={page}
      profile={profile}
      otherHref={lang === 'es' ? rutaEn : rutaEs}
    />

    <main id="main">
      <slot />
    </main>

    {/* Barra de progreso de lectura: 2px arriba, ancho proporcional al scroll. */}
    <script>
      const bar = document.getElementById('read-progress');
      if (bar) {
        let ticking = false;
        const update = () => {
          const d = document.documentElement;
          const max = Math.max(1, d.scrollHeight - d.clientHeight);
          bar.style.width = ((d.scrollTop / max) * 100).toFixed(2) + '%';
          ticking = false;
        };
        addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(update);
            }
          },
          { passive: true }
        );
        update();
      }
    </script>

    {/*
      Atajo privado Shift + Alt + P: alterna entre perfiles en esta pestaña,
      para mostrar una u otra versión en una entrevista sin cambiar la URL.
      Sin indicador. El perfil elegido se mantiene al navegar dentro de la
      pestaña (sessionStorage) y al recargar vuelve el perfil de la URL.
      Trae la misma página del otro perfil y cambia solo lo marcado con
      data-pv (textos, chips y CV); las islas interactivas no se tocan.
      No es un mecanismo de seguridad: el HTML de las dos versiones es público.
    */}
    <script>
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      const CLAVE = 'em-perfil';

      const resto = location.pathname.slice(base.length);
      const enUx = resto === '/ux' || resto.startsWith('/ux/');
      const propioPerfil = enUx ? 'ux' : 'ba';
      const otroPerfil = enUx ? 'ba' : 'ux';

      /** La misma página en el otro perfil: /x ↔ /ux/x. */
      const otraRuta = () => base + (enUx ? resto.slice(3) || '/' : '/ux' + resto);

      const leer = (): string | null => {
        try {
          return sessionStorage.getItem(CLAVE);
        } catch {
          return null;
        }
      };
      const guardar = (perfil: string) => {
        try {
          sessionStorage.setItem(CLAVE, perfil);
        } catch {
          /* sin almacenamiento: el cambio vale solo para esta página */
        }
      };

      type Foto = Map<string, string>;
      const fotografiar = (doc: Document): Foto => {
        const m: Foto = new Map([['__title', doc.title]]);
        doc.querySelectorAll<HTMLElement>('[data-pv]').forEach((el) => {
          m.set(el.dataset.pv ?? '', el.innerHTML);
        });
        return m;
      };
      const aplicar = (m: Foto) => {
        document.querySelectorAll<HTMLElement>('[data-pv]').forEach((el) => {
          const html = m.get(el.dataset.pv ?? '');
          if (html !== undefined) el.innerHTML = html;
        });
        document.title = m.get('__title') ?? document.title;
      };

      let propia: Foto | null = null;
      let otra: Foto | null = null;
      let mostrandoOtra = false;
      let cargando = false;

      const mostrar = async (quiereOtra: boolean) => {
        if (quiereOtra === mostrandoOtra) return;
        propia ??= fotografiar(document);
        if (quiereOtra && !otra) {
          cargando = true;
          try {
            const r = await fetch(otraRuta());
            if (!r.ok) return;
            otra = fotografiar(new DOMParser().parseFromString(await r.text(), 'text/html'));
          } catch {
            return;
          } finally {
            cargando = false;
          }
        }
        mostrandoOtra = quiereOtra;
        aplicar(quiereOtra && otra ? otra : propia);
      };

      const alternar = async () => {
        if (cargando) return;
        await mostrar(!mostrandoOtra);
        guardar(mostrandoOtra ? otroPerfil : propioPerfil);
      };

      /* Al cargar (y al volver con el botón Atrás, que restaura la página tal
         como quedó) se muestra el perfil que eligió esta pestaña. */
      const sincronizar = async () => {
        const visto = leer();
        await mostrar(visto !== null && visto !== propioPerfil);
        document.documentElement.removeAttribute('data-pv-pendiente');
      };
      void sincronizar();
      addEventListener('pageshow', (e) => {
        if (e.persisted) void sincronizar();
      });

      /* En captura: va antes que las teclas del panel, que también usan la P. */
      addEventListener(
        'keydown',
        (e) => {
          if (!e.shiftKey || !e.altKey || e.ctrlKey || e.metaKey || e.code !== 'KeyP') return;
          const t = e.target as HTMLElement | null;
          if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
          e.preventDefault();
          e.stopPropagation();
          void alternar();
        },
        true
      );
    </script>

    <style>
      #read-progress {
        position: fixed;
        left: 0;
        top: 0;
        height: 2px;
        width: 0;
        z-index: 95;
        pointer-events: none;
        background: linear-gradient(90deg, var(--mind), var(--clarity));
      }
    </style>
  </body>
</html>
